# ============================================================================
# Production config for docker-compose.prod.yml.
#   1. Copy this file to .env.prod   (cp .env.prod.example .env.prod)
#   2. Fill in real values below.
#   3. NEVER commit .env.prod — it is gitignored.
# ============================================================================

# Your domain (apex, no scheme). The app is served at https://${DOMAIN}, the API
# at https://api.${DOMAIN}. Point DNS A records for @ , www and api at this VPS.
DOMAIN=example.com

# Frontend base URL used in email links (reset password / verify email /
# renewal reminders). Leave blank to default to https://${DOMAIN}.
APP_URL=https://example.com

# ---- Database (MySQL) — use long random passwords ----
MYSQL_ROOT_PASSWORD=CHANGE_ME_strong_root_password
MYSQL_DATABASE=jmaa
MYSQL_USER=jmaa
MYSQL_PASSWORD=CHANGE_ME_strong_db_password

# ---- JWT secrets — generate each with:  openssl rand -hex 32 ----
JWT_ACCESS_SECRET=CHANGE_ME_64_hex_chars
JWT_REFRESH_SECRET=CHANGE_ME_DIFFERENT_64_hex_chars

# ---- First admin account (seeded on boot; promotes/creates this user as ADMIN) ----
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_strong_admin_password

# ---- Email (Resend) ----
# Needed for password-reset / verification / notification emails. Leave the key
# as re_xxx to log emails to the container console instead of sending them.
# MAIL_FROM must use a domain you've verified in Resend.
RESEND_API_KEY=re_xxx
MAIL_FROM="hudlgo <noreply@example.com>"

# ---- Optional: Google OAuth (leave blank to disable the Google login button) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Optional: Cloudflare Turnstile CAPTCHA on signup (leave blank to disable) ----
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---- Manual payments (no payment gateway) ----
# Customers pay offline (bank transfer / CashPlus / cash) and an admin activates
# their plan from /admin → Upgrade requests. These texts are shown with each
# request, per language. Placeholders: {amount} (MAD) and {reference} (HG-XXXXX).
# Use a literal 
 for a line break. Leave blank to use a generic default.
PAYMENT_INSTRUCTIONS_EN="Send {amount} MAD by bank transfer to RIB XXX XXX XXXXXXXXXXXXXXXX XX (hudlgo) or by CashPlus, and write {reference} in the description. Then message us on WhatsApp +212 6XX XX XX XX."
PAYMENT_INSTRUCTIONS_FR="Envoie {amount} MAD par virement au RIB XXX XXX XXXXXXXXXXXXXXXX XX (hudlgo) ou par CashPlus, avec la référence {reference} dans le motif. Puis écris-nous sur WhatsApp au +212 6XX XX XX XX."
PAYMENT_INSTRUCTIONS_AR="صيفط {amount} درهم بالتحويل للـ RIB XXX XXX XXXXXXXXXXXXXXXX XX (hudlgo) ولا بـ CashPlus، وكتب {reference} ف الوصف. من بعد كتب لينا ف واتساب +212 6XX XX XX XX."
