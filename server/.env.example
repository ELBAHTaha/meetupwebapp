# ---- Core ----
NODE_ENV=development
PORT=4000
# Origin(s) of the Vite frontend (CORS). May be a comma-separated list.
FRONTEND_URL=http://localhost:5173
# Canonical frontend base URL used in email links (password reset, verify email).
# Defaults to the first FRONTEND_URL origin. Production: https://hudlgo.com
APP_URL=http://localhost:5173

# ---- Database (MySQL 8) ----
# When using docker-compose, host is "mysql"; locally it's "localhost".
DATABASE_URL="mysql://jmaa:jmaa@localhost:3306/jmaa"

# ---- JWT ----
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=900s
JWT_REFRESH_TTL=30d

# ---- Google OAuth (optional — leave blank to disable) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

# ---- Storage (local disk for now) ----
STORAGE_DRIVER=local
UPLOADS_DIR=uploads
# Public base used to build absolute photo URLs
PUBLIC_URL=http://localhost:4000

# ---- Throttler ----
THROTTLE_TTL=60000
THROTTLE_LIMIT=120

# ---- Email (Resend) ----
# Leave the API key as "xxx" to log emails to the console instead of sending (dev
# simulation). Paste a real key (re_...) to send. MAIL_FROM must use a domain
# verified in Resend (onboarding@resend.dev works for testing to your own inbox).
RESEND_API_KEY=re_xxx
MAIL_FROM="hudlgo <onboarding@resend.dev>"

# ---- Manual payments (no gateway) ----
# Customers pay offline and an admin activates the plan. These texts are shown
# with every upgrade request. Placeholders: {amount} (MAD) and {reference}
# (e.g. HG-4F7K2). Use a literal 
 for a line break. Blank → a generic default.
PAYMENT_INSTRUCTIONS_EN="Send {amount} MAD by bank transfer to RIB 000 000 0000000000000000 00 (hudlgo) or by CashPlus, and write {reference} in the description. Then message us on WhatsApp +212 6 00 00 00 00."
PAYMENT_INSTRUCTIONS_FR=
PAYMENT_INSTRUCTIONS_AR=
